{
  "name": "faizan-ali-portfolio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reference": "serve ../design-reference -l 4100 --no-clipboard",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual --pass-with-no-tests",
    "test": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
