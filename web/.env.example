# Copy to .env.local and fill in values. Never commit real secrets.

# Public site URL, used for canonical links, Open Graph, the sitemap and robots.txt.
# Optional: on Vercel, the project's production address (VERCEL_PROJECT_PRODUCTION_URL)
# is used when this is empty, and locally http://localhost:3000. Set it in Vercel
# (Production and Preview) to the final address, with https:// and no trailing slash.
# NEXT_PUBLIC_SITE_URL=

# Contact form direct delivery through Resend (server-side only, never NEXT_PUBLIC_).
# Without RESEND_API_KEY the form opens the visitor's email app (mailto) instead.
# The contact page is prerendered, so after changing these on Vercel, redeploy.
# See README.md, "Contact form delivery".
# RESEND_API_KEY=
# Optional: the inbox that receives messages (default faizandevx@gmail.com).
# CONTACT_TO_EMAIL=
# Optional: the sender (default "Portfolio Contact <onboarding@resend.dev>", Resend's
# shared address, which needs no domain of our own).
# CONTACT_FROM_EMAIL=

# Reserved for a later, separately approved phase (not used yet):
# "Ask Faizan AI" assistant (server-side only).
# AI_PROVIDER_API_KEY=
